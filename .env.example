# 数据库配置
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=vnpy_quant

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# 交易所API配置（示例 - Binance）
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key
BINANCE_TESTNET=true

# CTP配置（期货）
CTP_USERID=your_ctp_userid
CTP_PASSWORD=your_ctp_password
CTP_BROKERID=your_ctp_brokerid
CTP_MD_ADDRESS=tcp://180.168.146.187:10131
CTP_TD_ADDRESS=tcp://180.168.146.187:10130

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/vnpy_quant.log

# 回测配置
BACKTEST_START_DATE=2020-01-01
BACKTEST_END_DATE=2023-12-31
BACKTEST_CAPITAL=1000000

# 风险管理
MAX_DAILY_LOSS=50000
MAX_POSITION_SIZE=0.3
STOP_LOSS_RATE=0.02